# Copia este archivo a .env y rellena el valor.
#   cp .env.example .env
#
# .env está en .gitignore y nunca debe commitearse.

# Contraseña del usuario admin@akopia.org que siembra la migración
# 023_seed_initial_superuser.js en la colección `users`.
#
# OJO: NO es el superusuario del panel /_/. Ese se crea aparte, con el
# enlace #/pbinstall/... que PocketBase imprime en el primer arranque.
#
# La migración solo corre una vez: cambiar este valor después no cambia
# la contraseña. Para eso, usa el panel o borra pb_data y vuelve a sembrar.
#
# Sin esta variable el arranque se detiene a propósito, para que nadie
# termine con una contraseña por defecto.
AKOPIA_INITIAL_ADMIN_PASSWORD=
